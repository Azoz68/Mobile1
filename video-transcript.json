  "text": "أو في دولة مختلفة"
 },
 {
  "start": 308.6,
  "end": 314.9,
  "text": "هنا غالباً نلقى فجوة أحثية منتازة"
 },
 {
  "start": 314.9,
  "end": 315.7,
  "text": "التفكير النقدي"
 },
 {
  "start": 315.7,
  "end": 317.3,
  "text": "critical thinking framework"
 },
 {
  "start": 317.3,
  "end": 319.4,
  "text": "أي باحث ناجح لازم يستخدم"
 },
 {
  "start": 319.4,
