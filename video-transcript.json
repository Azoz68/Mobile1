 {
  "start": 346.8,
  "end": 348.6,
  "text": "لكن نبنو عليها ونطورها"
 },
 {
  "start": 348.6,
  "end": 353.6,
  "text": "الفجوة القوية والضعيفة"
 },
 {
  "start": 353.6,
  "end": 355.3,
  "text": "strong gap versus weak gap"
 },
 {
  "start": 355.3,
  "end": 356.9,
  "text": "مش أي فجوة تعتبر قوية"
 },
 {
  "start": 356.9,
  "end": 359.3,
  "text": "strong research gap أو الفجوة القوية"
 },
 {
  "start": 359.3,
  "end": 360.9,
  "text": "تكون مدرومة بالأدلة"
 },
 {
  "start": 360.9,
  "end": 363.0,
  "text": "محددة قابلة للقياس"
 },
 {
  "start": 363.0,
  "end": 364.4,
  "text": "ولها قيمة علمية وعملية"
 },
 {
  "start": 364.4,
  "end": 366.6,
  "text": "أما weak gap أو الفجوة الضعيفة"
 },
 {
  "start": 366.6,
  "end": 368.7,
  "text": "تكون عامة جداً وغير واضحة"
 },
 {
  "start": 368.7,
  "end": 371.9,
  "text": "مثلاً لما نقول الصحة النفسية لم تدرس بشكل كافي"
 },
 {
  "start": 371.9,
  "end": 373.0,
  "text": "فهذه فجوة ضعيفة"
 },
 {
  "start": 373.0,
  "end": 376.2,
  "text": "لكن لما نقول لا توجد دراسة حول تأثير الدراسة عن بعد"
 },
 {
  "start": 376.2,
  "end": 379.3,
  "text": "على القلق عند طلاب الجامعات العربية بعد 2020"
 },
 {
  "start": 379.3,
  "end": 382.4,
  "text": "فهذه فجوة قوية واضحة وقابلة للبحث"
 },
 {
  "start": 382.4,
  "end": 386.9,
  "text": "وفي النهاية نقدر نقوله أن research gap"
 },
 {
  "start": 386.9,
  "end": 388.7,
  "text": "هي أساس أي بحث علمي ناجح"
 },
 {
  "start": 388.7,
  "end": 390.4,
  "text": "وأن الباحث المتميز"
 },
 {
  "start": 390.4,
  "end": 392.1,
  "text": "مش الشخص اللي يلقي الإجابات فقط"
 },
 {
  "start": 392.1,
  "end": 393.9,
  "text": "لكن الشخص اللي يطرح أسئلة"
 },
 {
  "start": 393.9,
  "end": 395.6,
  "text": "ما حدش فكر فيها من قبل"
 },
 {
  "start": 395.6,
  "end": 397.9,
  "text": "كانت معكم الدكتورة هناء حسين"
 },
 {
  "start": 397.9,
  "end": 399.4,
  "text": "شكراً لحسن الاستماع"
 }
]