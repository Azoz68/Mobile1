[
 {
  "start": 1.9,
  "end": 3.3,
  "text": "السلام عليكم ورحمة الله"
 },
 {
  "start": 3.3,
  "end": 4.9,
  "text": "معكم الدكتورة هناء حسين"
 },
 {
  "start": 4.9,
  "end": 7.1,
  "text": "من أكثر الأسئلة اللي جيني على الخاص"
 },
 {
  "start": 7.1,
  "end": 9.3,
  "text": "هي هل نقدروا نستخدم الذكاء الاصطناعي"
 },
 {
  "start": 9.3,
  "end": 11.0,
  "text": "عشان نوجدوا الفجوة البحثية"
 },
 {
  "start": 11.0,
  "end": 14.1,
  "text": "نعم لكن تابعوا الفيديو للنهاية عشان تعرفوا كيف"
 },
 {
  "start": 14.1,
  "end": 15.9,
  "text": "اليوم إن شاء الله هنتكلموا"
 },
 {
  "start": 15.9,
  "end": 17.8,
  "text": "على موضوع مهم جدا في البحث الألمي"
 },
 {
  "start": 17.8,
  "end": 19.9,
  "text": "وهو الـ Research Gaps أو الفجوات البحثية"
 },
 {
  "start": 20.5,
  "end": 21.7,
  "text": "الفجوة البحثية معناها"
 },
 {
  "start": 21.7,
  "end": 23.9,
  "text": "الشي مازال ما تمش دراسته بشكل كافي"
 },
 {
  "start": 23.9,
  "end": 25.8,
  "text": "أو نقطة الباحثين مركزوش عليها"
 },
 {
  "start": 25.8,
  "end": 26.4,
  "text": "بشكل واضح"
 },
 {
  "start": 26.4,
  "end": 28.6,
  "text": "في العرض التقديمي هذا هنتعلموا"
 },
 {
  "start": 28.6,
  "end": 29.8,
  "text": "شنو هي الـ Research Gap"
 },
 {
  "start": 29.8,
  "end": 31.3,
  "text": "عليش تعتبر مهمة"
 },
 {
  "start": 31.3,
  "end": 32.8,
  "text": "أنواعها المختلفة"
 },
 {
  "start": 32.8,
  "end": 34.6,
  "text": "وأهم شي كيف نكتشفوها باستخدام"
 },
 {
  "start": 34.6,
  "end": 36.2,
  "text": "الـ AI Tools أو الذكاء الاصطناعي"
 },
 {
  "start": 36.2,
  "end": 38.5,
  "text": "والهدف إن أي طالب أباحث بعد اليوم"
 },
 {
  "start": 38.5,
  "end": 39.9,
  "text": "يقدر يحدد فجوة بحثية قوية"
 },
 {
  "start": 39.9,
  "end": 41.1,
  "text": "بطريقة احترافية"
 },
 {
  "start": 41.1,
  "end": 47.1,
  "text": "تعريف الفجوة البحثية"
 },
 {
  "start": 47.1,
  "end": 48.5,
  "text": "What is a Research Gap"
 },
 {
  "start": 48.5,
  "end": 51.4,
  "text": "شنو نقصده بالـ Research Gap أو الفجوة البحثية"
 },
 {
  "start": 51.4,
  "end": 54.1,
  "text": "إذا ببساطة منطقة أو مشكلة في مجال معين"
 },
 {
  "start": 54.1,
  "end": 56.1,
  "text": "يا إما محدش درسها قبل"
 },
 {
  "start": 56.1,
  "end": 58.0,
  "text": "أو تم دراسته بشكل ناقص"
 },
 {
  "start": 58.0,
  "end": 60.0,
  "text": "أو تحتاج مزيد من التحليل والاستكشاف"
 },
 {
  "start": 60.0,
  "end": 62.2,
  "text": "وعندنا أكثر من شكل الفجوة البحثية"
 },
 {
  "start": 62.2,
  "end": 62.9,
  "text": "مثلاً"
 },
 {
  "start": 62.9,
  "end": 64.5,
  "text": "الـ Knowledge Gap أو فجوة المعرفة"
 },
 {
  "start": 64.5,
  "end": 66.2,
  "text": "لما يكون موضوع جديد بالكامل"
 },
 {
  "start": 66.2,
  "end": 67.4,
  "text": "أو الـ Partial Study"
 },
 {
  "start": 67.4,
  "end": 69.4,
  "text": "لما الموضوع يتدرس من زاوية واحدة بس"
 },
 {
  "start": 69.4,
  "end": 71.5,
  "text": "أو يكون فيه Conflicting Results"
 },
 {
  "start": 71.5,
  "end": 73.5,
  "text": "يعني نتائج متضاربة بين الدراسات"
 },
 {
  "start": 73.5,
  "end": 76.1,
  "text": "أو حتى اختلاف في الـ Geographical Context"
 },
 {
  "start": 76.1,
  "end": 77.2,
  "text": "أو السياق الجغرافي"
 },
 {
  "start": 77.2,
  "end": 79.6,
  "text": "يعني الدراسة اللي تنجح في دولة معينة"
 },
 {
  "start": 79.6,
  "end": 82.1,
  "text": "مش شرط تنجح بنفس الطريقة في مجتمع آخر"
 },
 {
  "start": 82.1,
  "end": 90.1,
  "text": "أهمية الفجوات البحثية"
 },
 {
  "start": 90.1,
  "end": 91.5,
  "text": "Why Research Gaps Matter"
 },
 {
  "start": 91.5,
  "end": 92.8,
  "text": "توي السؤال المهم"
 },
 {
  "start": 92.8,
  "end": 95.3,
  "text": "عليش الـ Research Gaps مهم جداً في البحث العلمي"
 },
 {
  "start": 95.3,
  "end": 97.5,
  "text": "أو الحاجة تعطيك Research Direction"
 },
 {
  "start": 97.5,
  "end": 98.9,
  "text": "أو اتجاه واضح لبحثك"
 },
 {
  "start": 98.9,
  "end": 101.2,
  "text": "ثاني حاجة تحقق scientific originality"
 },
 {
  "start": 101.2,
  "end": 102.1,
  "text": "أو الأصالة العلمية"
 },
 {
  "start": 102.1,
  "end": 104.6,
  "text": "يعني بحثك يكون فيه إضافة جديدة"
 },
 {
  "start": 104.6,
  "end": 106.7,
  "text": "كذلك تساعدك في Justifying the Study"
 },
 {
  "start": 106.7,
  "end": 108.8,
  "text": "أو تبرير دراسة قدام اللجنة العلمية"
 },
 {
  "start": 108.8,
  "end": 110.2,
  "text": "ومن فوائدها أيضاً"
 },
 {
  "start": 110.2,
  "end": 111.7,
  "text": "إنها تربط بين Literature Review"
 },
 {
  "start": 111.7,
  "end": 112.8,
  "text": "أو الدراسات السابقة"
 },
 {
  "start": 112.8,
  "end": 114.6,
  "text": "وبين الشيء الجديد اللي أنت حضيفه"
 },
 {
  "start": 114.6,
  "end": 117.5,
  "text": "حتى المجلات العلمية أو الأكدمك جيرنلز"
 },
 {
  "start": 117.5,
  "end": 119.5,
  "text": "تفضل الأبحاث لتعالج فجوات واضحة"
 },
 {
  "start": 119.5,
  "end": 121.4,
  "text": "وحتى الجهات المموي للبهوث"
 },
 {
  "start": 121.4,
  "end": 123.8,
  "text": "تبحث دائماً عن مشاكل حقيقية تحتاج خلود"
 },
 {
  "start": 123.8,
  "end": 135.2,
  "text": "أنواع الفجوات البحثية"
 },
 {
  "start": 135.2,
  "end": 136.4,
  "text": "Types of Research Gaps"
 },
 {
  "start": 136.4,
  "end": 139.0,
  "text": "الفجوات البحثية عندها أنواع مختلفة"
 },
 {
  "start": 139.0,
  "end": 140.8,
  "text": "وكل نوع له استخدام معين"
 },
 {
  "start": 140.8,
  "end": 142.6,
  "text": "أول نوع هو Knowledge Gap"
 },
 {
  "start": 142.6,
  "end": 143.5,
  "text": "أو فجوة المعرفة"
 },
 {
  "start": 143.5,
  "end": 146.0,
  "text": "وهي معلومة العلم ما يعرفها إلى الآن"
 },
 {
  "start": 146.0,
  "end": 147.5,
  "text": "بعدها ال Practice Gap"
 },
 {
  "start": 147.5,
  "end": 148.5,
  "text": "أو فجوة الممارسة"
 },
 {
  "start": 148.5,
  "end": 150.7,
  "text": "يعني الفرق بين النظرية وتطبيق الواقع"
 },
 {
  "start": 150.7,
  "end": 153.2,
  "text": "وعندنا أيضاً l'Evidence Gap أو فجوة الأدلة"
 },
 {
  "start": 153.2,
  "end": 155.1,
  "text": "لما تكون الأدلة العلمية غير كافية"
 },
 {
  "start": 155.1,
  "end": 157.3,
  "text": "وفيه l'Population Gap أو فجوة السكان"
 },
 {
  "start": 157.3,
  "end": 159.9,
  "text": "لما تكون فيها معينة ما تمتش دراستها بشكل كافي"
 },
 {
  "start": 159.9,
  "end": 162.5,
  "text": "كذلك l'Methological Hack أو الفجوة المنهجية"
 },
 {
  "start": 162.5,
  "end": 164.8,
  "text": "لما الباحثين يستخدموا منهج واحد فقط"
 },
 {
  "start": 164.8,
  "end": 167.4,
  "text": "وأخيراً l'Temporary Gap أو الفجوة الزمنية"
 },
 {
  "start": 167.4,
  "end": 170.4,
  "text": "لما الدراسات تكون قديمة ومتعكسش الوضع الحالي"
 },
 {
  "start": 170.4,
  "end": 174.1,
  "text": "أمثلة عملية"
 },
 {
  "start": 174.1,
  "end": 178.0,
  "text": "خلونا نشوف أمثلة عملية على الفجوات البحثية"
 },
 {
  "start": 178.0,
  "end": 180.7,
  "text": "مثلاً في فجوة المعرفة Knowledge Gap"
 },
 {
  "start": 180.7,
  "end": 182.7,
  "text": "ممكن نقول تأثير الذكاء الاستنائي"
 },
 {
  "start": 182.7,
  "end": 183.7,
  "text": "Artificial Intelligence"
 },
 {
  "start": 183.7,
  "end": 186.1,
  "text": "على القرارات الأخلاقية في القطاع الصحي العربي"
 },
 {
  "start": 186.1,
  "end": 187.9,
  "text": "ما تمش دراسته بشكل كافي"
 },
 {
  "start": 187.9,
  "end": 190.8,
  "text": "وفي فجوة الممارسة Practice Gap"
 },
 {
  "start": 190.8,
  "end": 192.4,
  "text": "البروتوكولات الطبية موجودة"
 },
 {
  "start": 192.4,
  "end": 194.0,
  "text": "لكن التطبيق الواقعي مختلف"
 },
 {
  "start": 194.0,
  "end": 196.1,
  "text": "وفي فجوة السكان Population Gap"
 },
 {
  "start": 196.1,
  "end": 198.1,
  "text": "معظم الدراسات على طلاب غربيين"
 },
 {
  "start": 198.1,
  "end": 200.5,
  "text": "لكن الشباب العربي مازال ناقص في الدراسات"
 },
 {
  "start": 200.5,
  "end": 203.3,
  "text": "وفي فجوة المنهجية Method Logic Gap"
 },
 {
  "start": 203.3,
  "end": 205.6,
  "text": "كل الدراسات استخدمت المنهج الكمي فقط"
 },
 {
  "start": 205.6,
  "end": 208.0,
  "text": "بينما المنهج النوئي ممكن يعطي تخاصيل عمق"
 },
 {
  "start": 208.0,
  "end": 210.5,
  "text": "وفي فجوة الزمنية Temple Gap"
 },
 {
  "start": 210.5,
  "end": 212.3,
  "text": "الدراسات القديمة قبل 2020"
 },
 {
  "start": 212.3,
  "end": 220.4,
  "text": "ما تعكسش التغيرات اللي صارت بعد الجائحة"
 },
 {
  "start": 220.4,
  "end": 222.4,
  "text": "تأوى صار عندنا مع تطور التكنولوجيا"
 },
 {
  "start": 223.0,
  "end": 224.7,
  "text": "أدوات ذكاء إصطناعي قوية"
 },
 {
  "start": 224.7,
  "end": 227.4,
  "text": "تساعد الباحثين يكتشف الفجوات البحثية بسرعة"
 },
 {
  "start": 227.4,
  "end": 228.4,
  "text": "أولاً"
