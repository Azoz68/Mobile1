 {
  "start": 286.5,
  "end": 289.6,
  "text": "لأن الباحثين غالباً يذكروا اكتراحات مستقبلية"
 },
 {
  "start": 289.6,
  "end": 290.7,
  "text": "ثاني حاجة"
